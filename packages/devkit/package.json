{
  "name": "@agenticos-dev/bot-devkit",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "default": "./src/index.js"
    },
    "./session": {
      "types": "./src/session.d.ts",
      "import": "./src/session.mjs",
      "default": "./src/session.mjs"
    }
  },
  "bin": {
    "bot-dev": "./src/cli.mjs",
    "gadget-dev": "./src/cli.mjs"
  },
  "files": [
    "src",
    "README.md",
    "PROVENANCE.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "@agenticos-dev/bot-archive-tools": "0.2.0",
    "@agenticos-dev/bot-contract": "0.2.0"
  },
  "engines": {
    "node": ">=22.17"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticos-stack/agenticos-bot-sdk.git",
    "directory": "packages/devkit"
  },
  "publishConfig": {
    "access": "public"
  }
}
